NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# base64-encoded 32-byte key; generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Legacy fallback for existing deployments. CREDENTIAL_ENCRYPTION_KEY wins when both are set.
# AGENT_LENS_ENCRYPTION_KEY=
# Optional override for the built-in public CloudFormation template URL.
AWS_CLOUDFORMATION_TEMPLATE_URL=
# Vercel OIDC assumes this app-owned broker role, then a customer-scoped role.
AWS_BROKER_ROLE_ARN=
AWS_BROKER_REGION=us-east-1
# Optional immutable public template URL overrides.
AWS_ACCESS_TEMPLATE_URL=
AWS_HOST_TEMPLATE_URL=
