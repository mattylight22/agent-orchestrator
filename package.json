{
  "name": "agent-lens",
  "productName": "Agent Lens",
  "version": "0.1.0",
  "private": true,
  "description": "A polished lens into GitHub-backed Paseo workstreams.",
  "workspaces": [
    "packages/*",
    "webapp"
  ],
  "main": "out/main/index.js",
  "type": "module",
  "build": {
    "appId": "com.agentlens.app",
    "productName": "Agent Lens",
    "directories": {
      "buildResources": "resources"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools"
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "node scripts/electron-vite-dev.mjs",
    "dev:demo": "AGENT_LENS_DEMO=1 node scripts/electron-vite-dev.mjs",
    "dev:web": "npm run dev --workspace=webapp",
    "build:web": "npm run build --workspace=webapp",
    "typecheck:web": "npm run typecheck --workspace=webapp",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@getpaseo/client": "^0.4.0",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-table": "^8.21.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "workflow": "^4.8.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.1.1",
    "electron-vite": "^4.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "undici": "7.29.0"
  }
}
